# Server
APP_ENV=development            # development | production
PORT=8080
BASE_URL=http://localhost:8080 # used for OAuth callback
FRONTEND_URL=http://localhost:3000 # redirect target after successful OAuth

# Database
DATABASE_URL=postgres://tobz:tobz@localhost:5432/tobz_api?sslmode=disable

# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Captcha (Cloudflare Turnstile)
CAPTCHA_ENABLED=true
TURNSTILE_SECRET=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m
