# Backend API base URL (include /api/v1)
VITE_API_BASE=http://localhost:8080/api/v1

# Set false to disable the Turnstile widget (must match backend CAPTCHA_ENABLED).
VITE_CAPTCHA_ENABLED=true

# Cloudflare Turnstile site key.
# Leave the test key below for local dev (always passes).
# Get a real key at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITEKEY=1x00000000000000000000AA
